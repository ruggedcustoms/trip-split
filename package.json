{
  "name": "trip-split",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Split trip expenses, run polls and chat with your friends. Runs on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:setup": "wrangler d1 execute trip-split --remote --file=schema.sql",
    "db:setup-local": "wrangler d1 execute trip-split --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
