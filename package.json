{
  "name": "trip-split",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Split trip expenses, run polls and chat with your friends. React + Vite on Vercel, data in Cloudflare D1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "npx wrangler d1 execute trip-split --remote --file=schema.sql",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:run": "vite build && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
